# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore — NUNCA versionar secretos.

# ─── Apps Script ────────────────────────────────────────────────
# URL /exec del Web App de registros (uniformes y exámenes).
APPS_SCRIPT_REGISTROS_URL=

# URL /exec del Web App de Eventos MMA (atletas, brackets, scoreboard).
# ⚠️ Tras la tarea N11, ambas URLs deben ROTARSE (las actuales están
# publicadas en el historial del repo). Ver TASKS-nextjs.md → N11.
APPS_SCRIPT_EVENTOS_URL=

# ─── Auth.js ────────────────────────────────────────────────────
# Firma las cookies de sesión. Generar con: openssl rand -base64 32
AUTH_SECRET=

# Credenciales OAuth de Google Cloud Console (tipo "Aplicación web").
# URIs de redirección autorizados que hay que registrar allí:
#   http://localhost:3000/api/auth/callback/google
#   https://<dominio-de-produccion>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Correos con acceso al admin, separados por comas. Se comparan en
# minúsculas y de forma exacta. Si queda vacía, NADIE entra (falla cerrado).
ADMIN_ALLOWED_EMAILS=

# ─── Sitio ──────────────────────────────────────────────────────
# Base para canonical, sitemap y OG. En producción: https://el-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
