# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore — NUNCA versionar secretos.

# ─── Apps Script ────────────────────────────────────────────────
# URL /exec del Web App de registros (uniformes y exámenes).
APPS_SCRIPT_REGISTROS_URL=

# URL /exec del Web App de Eventos MMA (atletas, brackets, scoreboard).
# ⚠️ Tras la tarea N11, ambas URLs deben ROTARSE (las actuales están
# publicadas en el historial del repo). Ver TASKS-nextjs.md → N11.
APPS_SCRIPT_EVENTOS_URL=

# ─── Auth.js ────────────────────────────────────────────────────
# Firma las cookies de sesión. Generar con: openssl rand -base64 32
AUTH_SECRET=

# Hash bcrypt de la contraseña compartida del staff. NUNCA la contraseña en
# claro. Generar en tu propia máquina con:
#   npx --yes bcrypt-cli hash 'la-contraseña'
# Si queda vacía, NADIE entra (falla cerrado).
#
# ⚠️ En ESTE archivo hay que escapar los signos de peso: el hash empieza con
# "$2b$..." y el parser de Next (@next/env) los expande como variables —
# incluso entre comillas simples — dejando el valor VACÍO. Escribe \$ en vez
# de $, así:
#   ADMIN_PASSWORD_HASH=\$2b\$10\$abc...
# En el panel de Netlify se pega tal cual, sin escapar: ahí no hay expansión.
ADMIN_PASSWORD_HASH=

# ─── Sitio ──────────────────────────────────────────────────────
# Base para canonical, sitemap y OG. En producción: https://el-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
